# Copy to `.env` (git-ignored) and fill in real values before `docker compose up -d --build`.

# Domain that points (DNS A record) at the Droplet's public IP. Required for automatic HTTPS.
APP_DOMAIN=exercise.codyclay.com

# PostgreSQL credentials. POSTGRES_PASSWORD should be a long random secret.
POSTGRES_DB=microburst
POSTGRES_USER=microburst
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
