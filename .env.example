# Copy to `.env` (git-ignored) and fill in real values before `docker compose up -d --build`.

# Domain that points (DNS A record) at the Droplet's public IP. Required for automatic HTTPS.
APP_DOMAIN=exercise.codyclay.com

# PostgreSQL credentials. POSTGRES_PASSWORD should be a long random secret.
POSTGRES_DB=microburst
POSTGRES_USER=microburst
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Where persistent state lives on the host (Postgres data + Data Protection keys).
# On the Droplet, set this to the mounted DigitalOcean Block Storage volume so the data
# survives a Droplet rebuild (see docs/DEPLOYMENT.md). Leave unset to use ./data on the
# Droplet's local disk.
# DATA_DIR=/mnt/microburst_data

# --- Off-site DB backups to DigitalOcean Spaces (S3-compatible), optional ---
# Leave SPACES_BUCKET empty to keep only the local rotated dumps under $DATA_DIR/backups.
# Create a Space + a Spaces access key pair in the DO console, then fill these in.
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
