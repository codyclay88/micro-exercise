<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MicroExercise.Maui.Pages.EditBurstPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MicroExercise.Maui.ViewModels"
    x:DataType="vm:EditBurstViewModel"
    Title="Edit burst">

    <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="480" HorizontalOptions="Center">
        <Label Text="{Binding ExerciseName}" FontSize="22" FontAttributes="Bold" />

        <VerticalStackLayout Spacing="2">
            <Label Text="Amount" FontSize="12" Opacity="0.6" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Keyboard="Numeric" Text="{Binding Quantity}" />
                <Label Grid.Column="1" Text="{Binding Unit}" VerticalOptions="Center" Opacity="0.6" />
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="2">
            <Label Text="Date" FontSize="12" Opacity="0.6" />
            <DatePicker Date="{Binding Date}" Format="MMM d, yyyy" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="2">
            <Label Text="Time" FontSize="12" Opacity="0.6" />
            <TimePicker Time="{Binding Time}" />
        </VerticalStackLayout>

        <HorizontalStackLayout Spacing="12">
            <Button Text="Save" Command="{Binding SaveCommand}" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
