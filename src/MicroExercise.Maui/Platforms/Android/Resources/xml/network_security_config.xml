<?xml version="1.0" encoding="utf-8"?>
<!-- Permit cleartext HTTP only to the local dev backend (Android emulator reaches the host's
     loopback via 10.0.2.2). Production (exercise.codyclay.com) stays HTTPS-only, so this is safe
     to keep in the shipped app. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
