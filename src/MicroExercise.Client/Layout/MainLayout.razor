@inherits LayoutComponentBase

@* Responsive navbar: links collapse behind a hamburger below the `md` breakpoint (phones),
   inline on larger screens. The toggle is driven by Blazor state (no Bootstrap JS dependency). *@
<nav class="navbar navbar-expand-md border-bottom mb-4">
    <div class="container">
        <a class="navbar-brand fw-semibold" href="/">⚡ Micro-Burst</a>

        @* Always-visible right cluster (theme toggle + hamburger). order-md-last floats it to the
           far right on desktop; on phones it sits next to the brand and the menu drops below. *@
        <div class="d-flex align-items-center gap-1 order-md-last">
            <ThemeToggle />
            <AuthorizeView>
                <Authorized>
                    <button class="navbar-toggler border-0 p-1" type="button"
                            @onclick="ToggleNav" aria-label="Toggle navigation" aria-expanded="@_navOpen">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        <AuthorizeView>
            <Authorized Context="auth">
                <div class="collapse navbar-collapse @(_navOpen ? "show" : null)">
                    <div class="navbar-nav me-auto">
                        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseNav">Log</NavLink>
                        <NavLink class="nav-link" href="/history" @onclick="CloseNav">History</NavLink>
                        <NavLink class="nav-link" href="/reports" @onclick="CloseNav">Reports</NavLink>
                        <NavLink class="nav-link" href="/goals" @onclick="CloseNav">Goals</NavLink>
                        <NavLink class="nav-link" href="/pool" @onclick="CloseNav">Pool</NavLink>
                    </div>
                    <span class="navbar-text small text-secondary me-md-3 py-1 py-md-0">@auth.User.Identity?.Name</span>
                    <form action="account/logout" method="post" class="py-1 py-md-0">
                        <button type="submit" class="btn btn-sm btn-outline-secondary border-0 ps-0 ps-md-2">Sign out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

<main class="container pb-5">
    @Body
</main>

@code {
    private bool _navOpen;

    private void ToggleNav() => _navOpen = !_navOpen;

    // Collapse the menu after navigating (the layout persists across same-layout routes, so the
    // dropdown would otherwise stay open on phones).
    private void CloseNav() => _navOpen = false;
}
