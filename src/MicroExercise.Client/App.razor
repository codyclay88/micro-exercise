@using MicroExercise.Client.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <div class="container py-5 text-secondary">Loading…</div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <PageTitle>Not Found · Micro-Burst</PageTitle>
                <h1 class="h4">Not Found</h1>
                <p class="text-secondary">Sorry, the content you are looking for does not exist.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
