@using MicroExercise.Core.Dtos
@using MicroExercise.Core.Enums
@inject BurstLogPrompt Prompt

@* A read-only summary of one pool exercise plus a Log button that opens the shared burst-log
   dialog pre-targeted to this exercise. The actual quantity is free-typed in the dialog (reps/
   seconds to failure), so there's no inline stepper here. The card pulses when a burst lands. *@
@if (Compact)
{
    <!-- List view: one tight horizontal row, optimized for vertical stacking. -->
    <div class="card shadow-sm quick-log-card quick-log-row @PulseClass">
        <div class="card-body d-flex align-items-center py-2">
            <div class="flex-grow-1 me-3 overflow-hidden">
                <div class="fw-medium text-truncate" title="@Item.DisplayName">@Item.DisplayName</div>
                <small class="text-secondary">@TodayBursts today · @TodayVolume @UnitLabel total</small>
            </div>
            <button type="button" class="btn btn-primary log-button user-select-none px-4" @onclick="OpenDialog">
                Log
            </button>
        </div>
    </div>
}
else
{
    <div class="card h-100 shadow-sm quick-log-card @PulseClass">
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <h2 class="h6 mb-0 text-truncate" title="@Item.DisplayName">@Item.DisplayName</h2>
                <small class="text-secondary text-nowrap ms-2">@TodayBursts today</small>
            </div>

            <!-- Primary action: opens the dialog to free-type this burst's amount. -->
            <button type="button"
                    class="btn btn-primary flex-grow-1 py-4 mb-2 log-button user-select-none"
                    @onclick="OpenDialog">
                <div class="fs-4 fw-bold lh-1">Log</div>
                <div class="small text-uppercase opacity-75">@DefaultHint</div>
            </button>

            <small class="text-secondary text-center">@TodayVolume @UnitLabel total today</small>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public PoolItemDto Item { get; set; } = default!;
    [Parameter] public int TodayBursts { get; set; }
    [Parameter] public long TodayVolume { get; set; }

    /// <summary>Render as a compact list row (vertical-stacking) instead of a grid card.</summary>
    [Parameter] public bool Compact { get; set; }

    private int _logSeq;        // bumped each time a burst lands; drives the pulse class
    private int _lastBursts;
    private bool _initialized;

    private string UnitLabel => Item.TrackingType == TrackingType.Seconds ? "sec" : "reps";

    /// <summary>The pre-filled default shown under the Log button — your last burst (e.g. "last 10 reps").</summary>
    private string DefaultHint => $"last {Item.LastQuantity} {UnitLabel}";

    // Alternate between two identical animation classes so each new burst restarts the
    // pulse (re-adding the same class wouldn't replay it). Empty until the first burst.
    private string PulseClass => _logSeq == 0 ? "" : (_logSeq % 2 == 1 ? "logged-pulse-a" : "logged-pulse-b");

    protected override void OnParametersSet()
    {
        // Pulse whenever a new burst lands (the parent advances TodayBursts) — but not on first load.
        if (_initialized && TodayBursts > _lastBursts)
            _logSeq++;
        _initialized = true;
        _lastBursts = TodayBursts;
    }

    private void OpenDialog() => Prompt.Request(Item);
}
