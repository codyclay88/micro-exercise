@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@inject PoolApi PoolApi
@inject LogApi LogApi
@inject ReportApi ReportApi
@inject IJSRuntime JS

<PageTitle>Micro-Burst · Log</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Today</h1>
    @if (_pool is not null)
    {
        <span class="text-secondary small">@_totalBurstsToday bursts logged today</span>
    }
</div>

@if (_pool is null)
{
    <p class="text-secondary">Loading…</p>
}
else if (_pool.Count == 0)
{
    <div class="text-center text-secondary py-5">
        <p class="mb-2">No exercises in your pool yet.</p>
        <a class="btn btn-primary" href="/pool">Add your first exercise</a>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
        @for (var i = 0; i < _pool.Count; i++)
        {
            var item = _pool[i];
            var stats = _today.GetValueOrDefault(item.Id);
            int? keyHint = i < 9 ? i + 1 : null;
            <div class="col">
                <QuickLogCard Item="item"
                              TodayBursts="stats.Bursts"
                              TodayVolume="stats.Volume"
                              KeyHint="keyHint"
                              OnLog="qty => LogAsync(item, qty)" />
            </div>
        }
    </div>
    <p class="text-secondary small mt-3 mb-0 d-none d-md-block">
        Tip: press <kbd>1</kbd>–<kbd>9</kbd> to log a card without the mouse.
    </p>
}

@code {
    private IReadOnlyList<PoolItemDto>? _pool;
    private readonly Dictionary<int, (int Bursts, long Volume)> _today = new();
    private int _totalBurstsToday;
    private DotNetObjectReference<Dashboard>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        _pool = await PoolApi.GetActivePoolAsync();

        // Seed each card with what's already been logged today (whole-day summary).
        var today = DateOnly.FromDateTime(DateTime.Today);
        var summary = await ReportApi.GetSummaryAsync(today, today);
        foreach (var row in summary)
            _today[row.ExercisePoolId] = ((int)row.TotalBursts, row.TotalVolume);

        _totalBurstsToday = summary.Sum(s => s.TotalBursts);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("microburstHotkeys.register", _selfRef);
        }
    }

    /// <summary>Invoked from hotkeys.js when a 1-9 digit key is pressed. Logs the
    /// matching card's standard target quantity (mouse-free quick log).</summary>
    [JSInvokable]
    public async Task OnHotkey(int number)
    {
        if (_pool is null || number < 1 || number > _pool.Count)
            return;

        var item = _pool[number - 1];
        await LogAsync(item, item.TargetQuantity);
        StateHasChanged();
    }

    private async Task LogAsync(PoolItemDto item, int quantity)
    {
        var result = await LogApi.LogAsync(new CreateLogRequest(item.Id, quantity));
        if (result is null)
            return;

        var current = _today.GetValueOrDefault(item.Id);
        _today[item.Id] = (current.Bursts + 1, current.Volume + quantity);
        _totalBurstsToday++;
    }

    public async ValueTask DisposeAsync()
    {
        if (_selfRef is null)
            return;

        try
        {
            await JS.InvokeVoidAsync("microburstHotkeys.unregister");
        }
        catch (JSDisconnectedException)
        {
            // Browser is going away — nothing to clean up.
        }

        _selfRef.Dispose();
    }
}
